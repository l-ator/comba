{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comba",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-29",
  "migrations": [
    {
      "new_sqlite_classes": ["SessionRoom"],
      "tag": "v1",
    },
  ],
  "env": {
    "dev": {
      "name": "comba-dev",
      "durable_objects": {
        "bindings": [{ "class_name": "SessionRoom", "name": "SESSION_ROOMS" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "comba-dev",
          "database_id": "3382065d-19f2-4e8c-ab82-a6152ccb2b0e",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "development",
        "COMBA_CHANNEL_ID": "C0BTRCY31RA",
      },
    },
    "prod": {
      "name": "comba",
      "durable_objects": {
        "bindings": [{ "class_name": "SessionRoom", "name": "SESSION_ROOMS" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "comba-prod",
          "database_id": "REPLACE_WITH_PROD_D1_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "prod",
        "COMBA_CHANNEL_ID": "REPLACE_WITH_PROD_SLACK_CHANNEL_ID",
      },
    },
  },
}
